{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"strict": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"types": ["node", "chrome", "vite/client"],
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/background/**/*.ts", "src/content-script/**/*.ts", "src/lib/**/*.ts"]
}